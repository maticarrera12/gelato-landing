---
import { scoopFlavors, toppings } from "../data/flavors";
---

<section id="creador" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span data-reveal="pop" class="inline-block px-4 py-1.5 rounded-full bg-candy-mango border border-candy-ink text-xs font-bold uppercase tracking-wider text-candy-ink">
      ¡Experiencia Interactiva!
    </span>
    <h2 data-reveal="words" data-reveal-delay="120" class="font-display font-bold text-4xl sm:text-5xl text-candy-ink mt-3">Armá tu Cono en el Lab</h2>
    <p data-reveal="up" data-reveal-delay="350" class="text-candy-ink/75 text-base mt-2">
      Hacé clic en los sabores para apilar hasta 3 bochas de helado sobre el cucurucho artesanal. ¡Combinalos a tu gusto!
    </p>
  </div>

  <div data-reveal="scale" data-reveal-delay="200" class="bg-white rounded-3xl border-2 border-candy-ink p-6 sm:p-10 shadow-pop-lg grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-7 space-y-6">
      <div>
        <h3 class="font-display font-bold text-xl text-candy-ink mb-3 flex items-center gap-2">
          <span>1. Elegí tus Bochas (Máx. 3)</span>
          <span id="scoopCounterBadge" class="text-xs bg-candy-cream border border-candy-ink px-2 py-0.5 rounded-full font-mono font-bold">0/3</span>
        </h3>

        <div data-reveal-group data-stagger="60" data-base="500" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {
            scoopFlavors.map((f) => (
              <button
                data-reveal="pop"
                data-scoop-name={f.name}
                data-scoop-color={f.color}
                data-scoop-text={f.textClass}
                class={`p-3 rounded-2xl border-2 border-candy-ink pressable text-left flex items-center gap-2.5 shadow-pop hover:-translate-y-0.5 ${f.btn}`}
              >
                <span class={`w-6 h-6 rounded-full border border-candy-ink shrink-0 ${f.dot}`} />
                <div class="truncate">
                  <div class="font-bold text-xs truncate">{f.short}</div>
                  <div class={`text-[10px] ${f.subClass}`}>{f.sub}</div>
                </div>
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-display font-bold text-xl text-candy-ink mb-3">2. Sumale Toppings</h3>
        <div data-reveal-group data-stagger="80" data-base="900" class="flex flex-wrap gap-2">
          {
            toppings.map((t) => (
              <button
                data-reveal="pop"
                data-topping={t.id}
                class="px-4 py-2 rounded-xl border-2 border-candy-ink bg-white font-bold text-xs hover:bg-candy-mint pressable inline-flex items-center gap-1.5"
              >
                <i class={`ph-bold ${t.icon} text-sm`} />
                {t.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="pt-4 border-t-2 border-candy-ink/10 flex flex-wrap items-center justify-between gap-4">
        <button data-reset-cone class="text-xs font-bold text-candy-ink/60 hover:text-candy-ink underline flex items-center gap-1">
          <i class="ph-bold ph-arrow-counter-clockwise"></i> Reiniciar Cono
        </button>
        <button data-order-cone class="px-6 py-3 rounded-xl bg-candy-blue text-white inline-flex items-center gap-2 font-display font-bold text-sm border-2 border-candy-ink shadow-pop hover:bg-candy-pink hover:text-candy-ink pressable">
          ¡Pedir Este Cono! <i class="ph-bold ph-ice-cream text-base"></i>
        </button>
      </div>
    </div>

    <div class="lg:col-span-5 flex flex-col items-center w-full">
      <div class="w-full max-w-sm h-[26rem] sm:h-[30rem] bg-candy-cream border-2 border-candy-ink rounded-3xl relative shadow-pop overflow-hidden">
        <!-- 3D view (three.js), mounted lazily by cone-builder.ts -->
        <div id="coneCanvas" class="absolute inset-0 touch-pan-y cursor-grab active:cursor-grabbing"></div>

        <!-- 2D fallback, hidden once the 3D view is ready -->
        <div id="coneFallback" class="absolute inset-0 p-4 flex flex-col items-center justify-end">
          <div id="toppingCherry" class="hidden absolute top-12 z-30 text-3xl text-candy-cherry animate-scoop-drop"><i class="ph-bold ph-cherries"></i></div>
          <div id="toppingCookie" class="hidden absolute top-16 right-16 z-30 text-2xl -rotate-12 animate-scoop-drop"><i class="ph-bold ph-cookie"></i></div>
          <div id="toppingSprinkles" class="hidden absolute top-20 z-20 text-xs font-mono font-bold tracking-widest text-2xl text-candy-blue animate-scoop-drop"><i class="ph-bold ph-confetti"></i></div>

          <div id="scoopsStack" class="flex flex-col-reverse items-center justify-end z-10 w-full -mb-3"></div>

          <div class="relative z-10">
            <svg width="130" height="150" viewBox="0 0 100 120">
              <polygon points="15,10 85,10 50,110" class="fill-candy-mango stroke-candy-ink" stroke-width="3"></polygon>
              <g class="stroke-candy-ink" stroke-width="2">
                <line x1="25" y1="25" x2="65" y2="80"></line>
                <line x1="40" y1="18" x2="72" y2="60"></line>
                <line x1="75" y1="25" x2="35" y2="80"></line>
                <line x1="60" y1="18" x2="28" y2="60"></line>
              </g>
            </svg>
          </div>
        </div>

        <div id="emptyNotice" class="absolute inset-x-0 top-0 flex items-start justify-center p-6 pt-8 text-center text-xs font-bold text-candy-ink/50 pointer-events-none transition-opacity duration-200">
          <span class="inline-flex items-center gap-1.5"><i class="ph-bold ph-hand-pointing text-sm"></i>Elegí tus sabores en los botones</span>
        </div>

        <div id="coneHint" class="absolute bottom-3 left-3 px-3 py-1 inline-flex items-center gap-1.5 rounded-full bg-white border border-candy-ink text-[10px] font-bold uppercase tracking-wider pointer-events-none transition-opacity duration-300">
          <i class="ph-bold ph-arrows-left-right text-xs"></i> Arrastrá para girar
        </div>
      </div>

      <div id="flavorListText" class="mt-4 text-xs font-bold text-center text-candy-ink bg-candy-mint/40 px-4 py-2 rounded-xl border border-candy-ink w-full max-w-sm">
        Cucurucho Waffle Vacío
      </div>
    </div>
  </div>
</section>
