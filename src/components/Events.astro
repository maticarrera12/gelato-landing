---
import { eventTypes } from "../data/shop";
const field =
  "w-full bg-white border-2 border-candy-ink rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none focus:shadow-pop-blue";
---

<section id="eventos" class="py-20 bg-candy-pink/25 border-y-2 border-candy-ink">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    <div data-reveal="left">
      <span class="text-xs font-extrabold uppercase tracking-widest text-candy-blue">Catering & Eventos</span>
      <h2 class="font-display font-bold text-4xl sm:text-5xl text-candy-ink mt-1">Llevamos el carrito a tu fiesta</h2>
      <p class="text-sm text-candy-ink/70 mt-3">Carrito pastel vintage, 6 sabores a elección y toppings a discreción. Desde 30 personas, con barista de helado incluido.</p>
      <ul class="mt-5 space-y-2 text-sm font-bold">
        <li class="flex items-center gap-2"><i class="ph-bold ph-check-circle text-candy-blue"></i> Cumpleaños, casamientos y eventos de empresa</li>
        <li class="flex items-center gap-2"><i class="ph-bold ph-check-circle text-candy-blue"></i> Opciones veganas y sin TACC</li>
        <li class="flex items-center gap-2"><i class="ph-bold ph-check-circle text-candy-blue"></i> Presupuesto en menos de 24 hs</li>
      </ul>
    </div>

    <form id="eventForm" data-reveal="right" class="bg-candy-cream border-2 border-candy-ink rounded-3xl p-6 shadow-pop-lg space-y-4">
      <label class="block text-xs font-bold">Nombre
        <input name="name" required autocomplete="name" class={`${field} mt-1`} />
      </label>
      <div class="grid grid-cols-2 gap-4">
        <label class="block text-xs font-bold">Fecha
          <input name="date" type="date" required class={`${field} mt-1`} />
        </label>
        <label class="block text-xs font-bold">Invitados
          <input name="guests" type="number" min="30" required placeholder="30+" class={`${field} mt-1`} />
        </label>
      </div>
      <label class="block text-xs font-bold">Tipo de evento
        <select name="type" class={`${field} mt-1`}>
          {eventTypes.map((t) => <option>{t}</option>)}
        </select>
      </label>
      <button type="submit" class="w-full flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-candy-blue text-white font-display font-bold border-2 border-candy-ink shadow-pop hover:-translate-y-0.5 pressable">
        <i class="ph-bold ph-whatsapp-logo text-xl"></i>
        <span>Pedir presupuesto</span>
      </button>
    </form>
  </div>
</section>
