---
import { palette } from "../data/palette";
---

<footer class="bg-candy-cream border-t-2 border-candy-ink py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-candy-pink border-2 border-candy-ink flex items-center justify-center font-display font-bold text-xl"><i class="ph-bold ph-ice-cream"></i></div>
      <div>
        <div class="font-display font-bold text-lg text-candy-ink">MIMI & CO.</div>
        <div class="text-[10px] text-candy-ink/60 font-mono">Palette 01 — Candy Studio</div>
      </div>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono font-bold">
      {
        palette.map((c) => (
          <>
            <span class={`w-3 h-3 rounded-full border border-candy-ink ${c.bg}`} />
            {c.hex}
          </>
        ))
      }
    </div>

    <div class="text-xs text-candy-ink/70">© 2026 MIMI & CO. Todos los derechos reservados.</div>
  </div>
</footer>
