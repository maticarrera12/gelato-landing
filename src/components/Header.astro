<header class="sticky top-0 z-40 bg-candy-cream/90 backdrop-blur-md border-b-2 border-candy-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2.5 group">
      <div class="w-11 h-11 rounded-2xl bg-candy-pink border-2 border-candy-ink shadow-pop flex items-center justify-center text-candy-ink font-display font-bold text-2xl group-hover:rotate-6 transition-transform">
        <i class="ph-bold ph-ice-cream"></i>
      </div>
      <div class="flex flex-col">
        <span class="font-display font-bold text-xl sm:text-2xl whitespace-nowrap tracking-tight text-candy-ink leading-none">MIMI & CO.</span>
        <span class="hidden sm:block text-[11px] font-extrabold uppercase tracking-widest text-candy-blue">Gelato & Candy Lab</span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-6 font-bold text-sm">
      <a href="#proceso" class="hover:text-candy-blue transition-colors">Proceso</a>
      <a href="#creador" class="hover:text-candy-blue transition-colors">Armá tu Helado</a>
      <a href="#sabores" class="hover:text-candy-blue transition-colors">Sabores Insignia</a>
      <a href="#mood" class="hover:text-candy-blue transition-colors">Mood Matcher</a>
      <a href="#pedir" class="hover:text-candy-blue transition-colors">Pedir</a>
      <a href="#eventos" class="hover:text-candy-blue transition-colors">Eventos</a>
      <a href="#visitanos" class="hover:text-candy-blue transition-colors">Visitanos</a>
    </nav>

    <div class="flex items-center gap-3">
      <button data-toggle-palette class="flex items-center gap-1.5 text-xs font-bold uppercase px-3.5 py-2 rounded-xl bg-candy-mint border-2 border-candy-ink shadow-pop hover:-translate-y-0.5 pressable">
        <i class="ph-bold ph-palette text-sm"></i>
        <span class="hidden sm:inline">Paleta</span>
      </button>
      <button type="button" data-toggle-cart aria-controls="cartDrawer" class="flex items-center gap-2 px-3.5 sm:px-5 py-2.5 whitespace-nowrap rounded-xl bg-candy-blue text-white font-display font-bold text-sm tracking-wide border-2 border-candy-ink shadow-pop hover:bg-candy-pink hover:text-candy-ink hover:shadow-none hover:translate-x-1 hover:translate-y-1 pressable">
        <i class="ph-bold ph-shopping-bag text-base sm:hidden"></i>
        <span class="hidden sm:inline">Mi pedido</span>
        <span id="cartCount" class="w-5 h-5 rounded-full bg-candy-mango text-candy-ink flex items-center justify-center text-xs font-bold">0</span>
      </button>
      <button id="navToggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileNav" class="lg:hidden w-10 h-10 rounded-xl bg-white border-2 border-candy-ink shadow-pop flex items-center justify-center text-lg pressable">
        <i class="ph-bold ph-list"></i>
      </button>
    </div>
  </div>

  <nav id="mobileNav" data-open="false" aria-label="Navegación" inert class="lg:hidden absolute top-full inset-x-0 bg-candy-cream border-b-2 border-candy-ink shadow-pop invisible opacity-0 -translate-y-2 transition-[opacity,translate,visibility] duration-150 data-[open=true]:visible data-[open=true]:opacity-100 data-[open=true]:translate-y-0 data-[open=true]:duration-200">
    <ul class="px-4 py-3 grid gap-1 font-display font-bold text-lg">
      <li><a href="#proceso" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Proceso</a></li>
      <li><a href="#creador" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Armá tu Helado</a></li>
      <li><a href="#sabores" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Sabores Insignia</a></li>
      <li><a href="#mood" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Mood Matcher</a></li>
      <li><a href="#pedir" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Pedir</a></li>
      <li><a href="#eventos" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Eventos</a></li>
      <li><a href="#visitanos" class="block py-2.5 px-3 rounded-xl hover:bg-candy-mint/50">Visitanos</a></li>
    </ul>
  </nav>
</header>
