---
import { rating, reviews } from "../data/reviews";
const stars = Array.from({ length: 5 });
---

<section id="resenas" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-2xl mx-auto">
    <span class="text-xs font-extrabold uppercase tracking-widest text-candy-blue">Lo que dicen</span>
    <h2 data-reveal="words" class="font-display font-bold text-4xl sm:text-5xl text-candy-ink mt-1">Clientes felices</h2>
    <p class="mt-3 flex items-center justify-center gap-2 text-sm font-bold">
      <span class="flex text-candy-mango text-lg" aria-hidden="true">
        {stars.map(() => <i class="ph-fill ph-star"></i>)}
      </span>
      <span class="font-mono">{rating.score}</span>
      <span class="text-candy-ink/60 font-medium">· {rating.count.toLocaleString("es-AR")} reseñas</span>
    </p>
  </div>

  <div data-reveal-group data-stagger="100" class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      reviews.map((r) => (
        <figure data-reveal="up" class={`${r.bg} border-2 border-candy-ink rounded-3xl p-5 shadow-pop flex flex-col justify-between`}>
          <blockquote class="text-sm text-candy-ink/90">“{r.text}”</blockquote>
          <figcaption class="mt-4 pt-3 border-t border-candy-ink/15 text-xs">
            <span class="flex text-candy-mango mb-1" aria-label="5 de 5 estrellas">
              {stars.map(() => <i class="ph-fill ph-star"></i>)}
            </span>
            <span class="font-bold">{r.name}</span> <span class="text-candy-ink/60">· {r.when}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
