---
import { storySteps } from "../data/story";
import ScoopArt from "./ScoopArt.astro";

const total = storySteps.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<!-- Scroll-pinned story: the 3D cone is assembled by scroll position (story.ts) -->
<section id="proceso" data-story class="relative h-[440vh] scroll-mt-20">
  <div data-story-pin class="sticky top-20 h-[calc(100svh-5rem)]">
    <div class="max-w-7xl mx-auto w-full h-full px-4 sm:px-6 lg:px-8 py-5 lg:py-8 grid grid-rows-[auto_1fr] lg:grid-rows-1 lg:grid-cols-12 gap-5 lg:gap-12 items-center">
      <!-- 3D stage -->
      <div class="lg:col-span-7 lg:order-2 h-[38svh] lg:h-full lg:max-h-[36rem] relative overflow-hidden rounded-3xl border-2 border-candy-ink bg-candy-cream shadow-pop-lg">
        {
          storySteps.map((s, i) => (
            <div
              data-story-tint={i}
              class={`absolute inset-0 transition-opacity duration-500 ease-out ${s.tint} ${i === 0 ? "opacity-100" : "opacity-0"}`}
            />
          ))
        }
        <div id="storyFallback" class="absolute inset-0 flex items-center justify-center">
          <ScoopArt color="#FFC7EA" class="h-3/4" />
        </div>
        <div id="storyCone" class="absolute inset-0 touch-pan-y cursor-grab active:cursor-grabbing"></div>
      </div>

      <!-- Copy -->
      <div class="lg:col-span-5 lg:order-1 flex flex-col gap-3 lg:gap-6">
        <div>
          <span data-reveal="fade" class="inline-block text-candy-blue text-xs uppercase font-extrabold tracking-widest">// EL PROCESO</span>
          <h2 data-reveal="words" data-reveal-delay="100" class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-candy-ink mt-1 leading-[1.02]">
            Así se hace tu gelato
          </h2>
        </div>

        <div class="grid">
          {
            storySteps.map((s, i) => (
              <article
                data-story-step={i}
                data-active={i === 0 ? "true" : "false"}
                aria-hidden={i === 0 ? "false" : "true"}
                class="col-start-1 row-start-1 transition-[opacity,translate] duration-150 opacity-0 translate-y-3 pointer-events-none motion-reduce:translate-y-0 data-[active=true]:opacity-100 data-[active=true]:translate-y-0 data-[active=true]:pointer-events-auto data-[active=true]:duration-300 data-[active=true]:delay-100"
              >
                <div class="flex items-center gap-2 mb-2 lg:mb-3">
                  <span class="font-display font-bold text-sm px-2.5 py-1 rounded-full bg-candy-ink text-white">
                    {pad(i + 1)} / {pad(total)}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-white border border-candy-ink">
                    <i class={`ph-bold ${s.icon}`} />
                    {s.tag}
                  </span>
                </div>
                <h3 class="font-display font-bold text-2xl lg:text-4xl text-candy-ink leading-tight">{s.title}</h3>
                <p class="mt-1.5 lg:mt-3 text-sm lg:text-base text-candy-ink/75 font-medium max-w-md leading-relaxed">{s.copy}</p>
                {i === 0 && (
                  <p class="mt-3 lg:mt-5 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-candy-blue">
                    <i class="ph-bold ph-arrow-down animate-bounce" />
                    Seguí scrolleando
                  </p>
                )}
                {i === total - 1 && (
                  <a
                    href="#creador"
                    class="mt-3 lg:mt-5 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-candy-pink text-candy-ink font-display font-bold text-sm border-2 border-candy-ink shadow-pop hover:bg-candy-mango hover:shadow-none hover:translate-x-1 hover:translate-y-1 pressable"
                  >
                    Armar mi cono
                    <i class="ph-bold ph-arrow-right" />
                  </a>
                )}
              </article>
            ))
          }
        </div>

        <!-- Progress rail: one segment per step, filled with scaleX -->
        <div class="flex gap-2" aria-hidden="true">
          {
            storySteps.map((_, i) => (
              <div class="h-2 flex-1 rounded-full bg-candy-ink/10 border border-candy-ink overflow-hidden">
                <div data-story-fill={i} class="h-full w-full origin-left bg-candy-blue" style="transform: scaleX(0)" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
